        "## Define kafka configuration\n",
        "\n",
        "### Subtask:\n",
        "Write Terraform code to define the Kafka cluster resources, including Strimzi operator deployment, Kafka custom resource, and any necessary Kubernetes resources (Services, Ingress).\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "2f199b19"
      },
      "source": [
        "**Reasoning**:\n",
        "Write the Terraform configuration to define the Kubernetes and Helm providers, the Kafka namespace, deploy the Strimzi operator using Helm, define the Kafka custom resource, and potentially define Kubernetes services or ingress for Kafka access, combining steps 1 through 6 of the instructions.\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "bbddb3a5"
      },
      "outputs": [],
      "source": [
        "# Append the Kubernetes and Helm provider configurations to main.tf\n",
        "# Also append the Kafka and Strimzi related Kubernetes resources.\n",
        "\n",
        "kafka_terraform_config = \"\"\"\n",
        "\n",
        "# Configure the Kubernetes Provider to connect to the EKS cluster\n",
        "provider \"kubernetes\" {\n",
        "  host                   = aws_eks_cluster.agi_automotive_eks_cluster.endpoint\n",
        "  cluster_ca_certificate = base64decode(aws_eks_cluster.agi_automotive_eks_cluster.certificate_authority[0].data)\n",
        "  token                  = data.aws_auth.current.token # Use data source to get token\n",
        "}\n",
        "\n",
        "# Data source to get AWS authenticator token for Kubernetes\n",
        "data \"aws_eks_cluster_auth\" \"current\" {\n",
        "  name = aws_eks_cluster.agi_automotive_eks_cluster.name\n",
        "}\n",
        "\n",
        "# Configure the Helm Provider to deploy charts to the EKS cluster\n",
        "provider \"helm\" {\n",
        "  kubernetes {\n",
        "    host                   = aws_eks_cluster.agi_automotive_eks_cluster.endpoint\n",
        "    cluster_ca_certificate = base64decode(aws_eks_cluster.agi_automotive_eks_cluster.certificate_authority[0].data)\n",
        "    token                  = data.aws_auth.current.token\n",
        "  }\n",
        "}\n",
        "\n",
        "# Define a Kubernetes Namespace for Strimzi and Kafka\n",
        "resource \"kubernetes_namespace\" \"kafka_namespace\" {\n",
        "  metadata {\n",
        "    name = \"kafka\"\n",
        "  }\n",
        "}\n",
        "\n",
        "# Deploy the Strimzi Kafka operator using the Helm provider\n",
        "resource \"helm_release\" \"strimzi_operator\" {\n",
        "  name       = \"strimzi-kafka-operator\"\n",
        "  repository = \"https://strimzi.io/charts/\"\n",
        "  chart      = \"strimzi-kafka-operator\"\n",
        "  namespace  = kubernetes_namespace.kafka_namespace.metadata[0].name\n",
        "  version    = \"0.41.0\" # Specify a compatible Strimzi version\n",
        "  timeout    = 600\n",
        "\n",
        "  values = [\n",
        "    file(\"prometheus_values.yaml\") # Assuming prometheus_values.yaml contains Strimzi-specific Prometheus configuration\n",
        "  ]\n",
        "\n",
        "  depends_on = [kubernetes_namespace.kafka_namespace]\n",
        "}\n",
        "\n",
        "# Define the Kafka cluster Custom Resource\n",
        "# This resource depends on the Strimzi operator being deployed and ready.\n",
        "resource \"kubernetes_manifest\" \"kafka_cluster\" {\n",
        "  provider = kubernetes # Explicitly use the kubernetes provider\n",
        "\n",
        "  manifest = {\n",
        "    apiVersion = \"kafka.strimzi.io/v1beta2\"\n",
        "    kind       = \"Kafka\"\n",
        "    metadata = {\n",
        "      name      = \"my-kafka-cluster\" # Name of your Kafka cluster\n",
        "      namespace = kubernetes_namespace.kafka_namespace.metadata[0].name\n",
        "    }\n",
        "    spec = {\n",
        "      kafka = {\n",
        "        version = \"3.7.0\" # Specify Kafka version\n",
        "        replicas = 3      # Number of Kafka brokers\n",
        "        listeners = [\n",
        "          {\n",
        "            name = \"plain\"\n",
        "            port = 9092\n",
        "            type = \"internal\" # Internal listener for agents within EKS\n",
        "            tls = false\n",
        "          },\n",
        "          {\n",
        "            name = \"tls\"\n",
        "            port = 9093\n",
        "            type = \"internal\" # TLS listener for agents within EKS\n",
        "            tls = true\n",
        "            authentication = {\n",
        "              type = \"tls\"\n",
        "            }\n",
        "          }\n",
        "          # Add external listeners if needed, with appropriate security\n",
        "          # {\n",
        "          #   name = \"external\"\n",
        "          #   port = 9094\n",
        "          #   type = \"nodeport\" # Example for external access (consider security!)\n",
        "          #   tls = true\n",
        "          #   authentication = {\n",
        "          #     type = \"tls\"\n",
        "          #   }\n",
        "          # }\n",
        "        ]\n",
        "        storage = {\n",
        "          type = \"jbod\"\n",
        "          volumes = [\n",
        "            {\n",
        "              id = 0\n",
        "              type = \"persistent-claim\"\n",
        "              size = \"100Gi\" # Size of persistent volume per broker\n",
        "              deleteClaim = false\n",
        "            }\n",
        "          ]\n",
        "        }\n",
        "        # Configure resources for Kafka brokers\n",
        "        resources = {\n",
        "          requests = {\n",
        "            cpu = \"500m\"\n",
        "            memory = \"2Gi\"\n",
        "          }\n",
        "          limits = {\n",
        "            cpu = \"2000m\"\n",
        "            memory = \"8Gi\"\n",
        "          }\n",
        "        }\n",
        "      }\n",
        "      zookeeper = {\n",
        "        replicas = 3 # Number of ZooKeeper nodes\n",
        "        storage = {\n",
        "          type = \"persistent-claim\"\n",
        "          size = \"10Gi\" # Size of persistent volume per ZooKeeper node\n",
        "          deleteClaim = false\n",
        "        }\n",
        "        # Configure resources for ZooKeeper nodes\n",
        "        resources = {\n",
        "          requests = {\n",
        "            cpu = \"200m\"\n",
        "            memory = \"1Gi\"\n",
        "          }\n",
        "          limits = {\n",
        "            cpu = \"1000m\"\n",
        "            memory = \"4Gi\"\n",
        "          }\n",
        "        }\n",
        "      }\n",
        "      entity_operator = {\n",
        "        topicOperator = {}\n",
        "        userOperator = {}\n",
        "      }\n",
        "    }\n",
        "  }\n",
        "\n",
        "  depends_on = [helm_release.strimzi_operator]\n",
        "}\n",
        "\n",
        "# Optional: Define Kubernetes Services or Ingress for external access if necessary.\n",
        "# Example: NodePort service for the external listener (if defined in Kafka CR)\n",
        "# resource \"kubernetes_service\" \"kafka_external_service\" {\n",
        "#   metadata {\n",
        "#     name      = \"my-kafka-cluster-kafka-external-bootstrap\"\n",
        "#     namespace = kubernetes_namespace.kafka_namespace.metadata[0].name\n",
        "#   }\n",
        "#   spec {\n",
        "#     selector = {\n",
        "#       \"strimzi.io/cluster\" = \"my-kafka-cluster\"\n",
        "#       \"strimzi.io/kind\"    = \"Kafka\"\n",
        "#       \"strimzi.io/name\"    = \"my-kafka-cluster-kafka\"\n",
        "#     }\n",
        "#     port {\n",
        "#       name        = \"external\"\n",
        "#       port        = 9094\n",
        "#       target_port = 9094\n",
        "#       protocol    = \"TCP\"\n",
        "#     }\n",
        "#     type = \"NodePort\" # Or LoadBalancer, depending on requirements and security\n",
        "#   }\n",
        "#   depends_on = [kubernetes_manifest.kafka_cluster]\n",
        "# }\n",
        "\n",
        "# Add outputs for Kafka cluster details if needed\n",
        "output \"kafka_namespace\" {\n",
        "  description = \"The name of the Kubernetes namespace for Kafka\"\n",
        "  value       = kubernetes_namespace.kafka_namespace.metadata[0].name\n",
        "}\n",
        "\n",
        "output \"kafka_cluster_name\" {\n",
        "  description = \"The name of the Kafka cluster\"\n",
        "  value       = kubernetes_manifest.kafka_cluster.manifest.metadata.name\n",
        "}\n",
        "\n",
        "output \"kafka_brokers_internal\" {\n",
        "  description = \"Internal Kafka broker addresses (example, actual service may vary)\"\n",
        "  value       = \"my-kafka-cluster-kafka-bootstrap.kafka.svc.cluster.local:9092\" # Example internal address\n",
        "}\n",
        "\"\"\"\n",
        "\n",
        "# Append the Kafka configuration to main.tf\n",
        "with open(\"main.tf\", \"a\") as f:\n",
        "    f.write(kafka_terraform_config)\n",
        "\n",
        "print(\"Terraform configuration for Kafka and Strimzi appended to main.tf\")"
      ]
