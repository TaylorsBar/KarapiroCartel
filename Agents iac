      "source": [
        "# Append the monitoring stack configuration to main.tf\n",
        "\n",
        "monitoring_terraform_config = \"\"\"\n",
        "\n",
        "# Define a Kubernetes Namespace for Monitoring components\n",
        "resource \"kubernetes_namespace\" \"monitoring_namespace\" {\n",
        "  metadata {\n",
        "    name = \"monitoring\"\n",
        "  }\n",
        "}\n",
        "\n",
        "# Deploy the Prometheus stack using the Helm provider\n",
        "# Using the stable community-maintained kube-prometheus-stack chart\n",
        "resource \"helm_release\" \"prometheus_stack\" {\n",
        "  name       = \"prometheus\"\n",
        "  repository = \"https://prometheus-community.github.io/helm-charts\"\n",
        "  chart      = \"kube-prometheus-stack\"\n",
        "  namespace  = kubernetes_namespace.monitoring_namespace.metadata[0].name\n",
        "  version    = \"58.3.1\" # Specify a compatible chart version\n",
        "  timeout    = 900 # Increase timeout as this chart deploys multiple components\n",
        "\n",
        "  # Configure values to scrape Kafka/Strimzi metrics and potentially use prometheus_values.yaml\n",
        "  values = [\n",
        "    # Standard configuration values for the chart\n",
        "    file(\"prometheus_values.yaml\"), # Reference the provided prometheus_values.yaml\n",
        "\n",
        "    # Example of additional configuration to ensure Strimzi/Kafka metrics are scraped\n",
        "    # This might need adjustment based on the actual contents of prometheus_values.yaml\n",
        "    # and how Strimzi exposes metrics (typically via PodMonitors or ServiceMonitors)\n",
        "    # serviceMonitorSelectorNilUsesHelmValues = false # Ensure default selectors are used\n",
        "    # podMonitorSelectorNilUsesHelmValues     = false # Ensure default selectors are used\n",
        "    #\n",
        "    # alertmanager:\n",
        "    #   enabled: true\n",
        "    #\n",
        "    # grafana:\n",
        "    #   enabled: true\n",
        "    #   adminPassword: \"changeme\" # CHANGE THIS IN PRODUCTION! Use Kubernetes Secret.\n",
        "    #   service:\n",
        "    #     type: LoadBalancer # Or ClusterIP + Ingress\n",
        "    #     port: 80\n",
        "    #\n",
        "    # prometheus:\n",
        "    #   prometheusSpec:\n",
        "    #     serviceMonitorNamespaceSelectors:\n",
        "    #       - matchNames: [\"kafka\", \"monitoring\"] # Scrape ServiceMonitors in 'kafka' and 'monitoring' namespaces\n",
