        "            authentication = {\n",
        "              type = \"tls\"\n",
        "            }\n",
        "          }\n",
        "        ]\n",
        "        storage = {\n",
        "          type = \"jbod\"\n",
        "          volumes = [\n",
        "            {\n",
        "              id = 0\n",
        "              type = \"persistent-claim\"\n",
