        "    Statement = [\n",
        "      {\n",
        "        Effect = \"Allow\"\n",
        "        Principal = {\n",
        "          Service = \"ec2.amazonaws.com\"\n",
        "        }\n",
        "        Action = \"sts:AssumeRole\"\n",
        "      }\n",
        "    ]\n",
        "  })\n",
        "}\n",
        "\n",
        "# Attach necessary AWS managed policies to the node group role\n",
        "resource \"aws_iam_role_policy_attachment\" \"eks_node_group_amazon_eks_worker_node_policy\" {\n",
