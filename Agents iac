        "  vpc_id      = aws_vpc.eks_vpc.id\n",
        "\n",
        "   ingress {\n",
        "    description = \"Allow all traffic from other worker nodes\"\n",
        "    from_port   = 0\n",
        "    to_port     = 0\n",
        "    protocol    = \"-1\"\n",
        "    self = true\n",
        "  }\n",
        "\n",
        "  ingress {\n",
        "      description = \"Allow inbound traffic from public subnets (for ELBs/ALBs)\"\n",
        "      from_port   = 0\n",
        "      to_port     = 0\n",
