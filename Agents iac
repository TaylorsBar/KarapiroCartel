        "\n",
        "\n",
        "# Optional: Define Kubernetes Ingress for Grafana access if Service type is ClusterIP\n",
        "# This requires an Ingress Controller to be installed on the cluster (e.g., nginx-ingress, ALB-ingress-controller)\n",
