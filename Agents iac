        "class AgentCommunicationBus:\n",
        "    def __init__(self):\n",
        "        self._messages = [] # Simple list as a queue\n",
        "        self._subscribers = defaultdict(list) # topic -> list of agents\n",
        "        print(\"AgentCommunicationBus initialized (simulated).\")\n",
        "\n",
        "    def publish(self, message):\n",
        "        \"\"\"Simulates publishing a message to the bus.\"\"\"\n",
        "        print(f\"CommunicationBus: Publishing message (type: {message.get('type')}, id: {message.get('message_id')})...\")\n",
        "        self._messages.append(message)\n",
        "        # In a real Kafka system, messages go to topics.\n",
        "        # For this simulation, we'll just add to a central queue.\n",
        "\n",
        "    def subscribe(self, agent, topic=\"all\"):\n",
        "        \"\"\"Simulates an agent subscribing to a topic.\"\"\"\n",
        "        if agent is None:\n",
        "            print(f\"CommunicationBus: Warning: Attempted to subscribe a None agent to topic '{topic}'. Skipping.\")\n",
        "            return\n",
        "        print(f\"CommunicationBus: Agent '{agent.name}' subscribed to topic '{topic}'.\")\n",
        "        self._subscribers[topic].append(agent)\n",
        "        # In a real Kafka system, agents would use consumers.\n",
        "\n",
        "    def process_pending_messages(self):\n",
        "        \"\"\"Simulates the bus delivering messages to subscribers and agents processing them.\"\"\"\n",
        "        print(f\"\\nCommunicationBus: Processing {len(self._messages)} pending messages...\")\n",
        "        pending_messages = list(self._messages) # Get all current messages\n",
        "        self._messages = [] # Clear the bus\n",
        "\n",
        "        if not pending_messages:\n",
        "            print(\"CommunicationBus: No messages to process.\")\n",
        "            return\n",
        "\n",
        "        for message in pending_messages:\n",
        "            message_type = message.get(\"type\", \"unknown\")\n",
        "            print(f\"CommunicationBus: Delivering message {message.get('message_id')} (type: {message_type})...\")\n",
        "\n",
        "            # Simulate delivery to agents subscribed to 'all' or the specific message type\n",
        "            # This is a simplified routing model\n",
        "            delivered_to_agents = []\n",
        "            # Iterate over a copy of the subscribers list in case processing a message\n",
        "            # triggers a new subscription or unsubscription (though not implemented here)\n",
        "            for subscriber in list(self._subscribers.get(\"all\", [])) + list(self._subscribers.get(message_type, [])):\n",
        "                 # Avoid delivering the message back to the agent that published it immediately in this simple model\n",
        "                 # In a real system, consumers handle this naturally.\n",
        "                 if subscriber.name != message.get(\"source\"):\n",
        "                    print(f\"CommunicationBus: Delivering message {message.get('message_id')} to '{subscriber.name}'.\")\n",
        "                    try:\n",
        "                        subscriber.process_message(message) # Agent processes the message\n",
        "                        delivered_to_agents.append(subscriber.name)\n",
        "                    except NotImplementedError:\n",
        "                        print(f\"CommunicationBus: Subscriber '{subscriber.name}' does not implement process_message.\")\n",
        "                    except Exception as e:\n",
        "                        print(f\"CommunicationBus: Error delivering message {message.get('message_id')} to '{subscriber.name}': {e}\")\n",
        "\n",
        "\n",
        "            if not delivered_to_agents:\n",
        "                 print(f\"CommunicationBus: No agents subscribed to process message {message.get('message_id')} (type: {message_type}).\")\n",
        "\n",
