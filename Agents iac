      "source": [
        "# Recreate the complete main.tf file with corrected helm provider configuration\n",
        "\n",
        "complete_terraform_config_helm_corrected = \"\"\"\n",
        "# Configure the AWS Provider\n",
        "provider \"aws\" {\n",
        "  region = \"us-east-1\" # Specify your desired AWS region\n",
        "}\n",
        "\n",
        "# Define the VPC for the EKS cluster\n",
        "resource \"aws_vpc\" \"eks_vpc\" {\n",
        "  cidr_block = \"10.0.0.0/16\"\n",
        "  enable_dns_hostnames = true\n",
        "  enable_dns_support   = true\n",
        "\n",
        "  tags = {\n",
        "    Name = \"agi-automotive-eks-vpc\"\n",
        "  }\n",
        "}\n",
        "\n",
        "# Define public subnets across multiple Availability Zones\n",
        "resource \"aws_subnet\" \"public_subnets\" {\n",
        "  count             = 2 # Deploy across 2 Availability Zones\n",
        "  vpc_id            = aws_vpc.eks_vpc.id\n",
        "  cidr_block        = \"10.0.${count.index}.0/24\"\n",
        "  availability_zone = data.aws_availability_zones.available.names[count.index]\n",
        "  map_public_ip_on_launch = true # Public subnets need public IPs for internet access\n",
        "\n",
        "  tags = {\n",
        "    Name = \"agi-automotive-public-subnet-${count.index}\"\n",
        "    \"kubernetes.io/cluster/${var.cluster_name}\" = \"shared\" # Tag required by EKS\n",
        "    \"kubernetes.io/role/elb\"                    = \"1\"      # Tag required for public ELBs\n",
        "  }\n",
        "}\n",
        "\n",
        "# Define private subnets across multiple Availability Zones\n",
        "resource \"aws_subnet\" \"private_subnets\" {\n",
        "  count             = 2 # Deploy across 2 Availability Zones\n",
        "  vpc_id            = aws_vpc.eks_vpc.id\n",
        "  cidr_block        = \"10.0.${count.index + 100}.0/24\"\n",
        "  availability_zone = data.aws_availability_zones.available.names[count.index]\n",
        "\n",
        "  tags = {\n",
        "    Name = \"agi-automotive-private-subnet-${count.index}\"\n",
        "    \"kubernetes.io/cluster/${var.cluster_name}\" = \"shared\" # Tag required by EKS\n",
        "    \"kubernetes.io/role/internal-elb\"           = \"1\"      # Tag required for internal ELBs\n",
        "  }\n",
        "}\n",
        "\n",
        "# Data source to get available availability zones\n",
        "data \"aws_availability_zones\" \"available\" {\n",
        "  state = \"available\"\n",
        "}\n",
        "\n",
        "# Define Security Group for the EKS Control Plane\n",
        "resource \"aws_security_group\" \"eks_control_plane_sg\" {\n",
        "  name        = \"agi-automotive-eks-control-plane-sg\"\n",
        "  description = \"Security group for EKS control plane\"\n",
        "  vpc_id      = aws_vpc.eks_vpc.id\n",
        "\n",
        "  tags = {\n",
        "    Name = \"agi-automotive-eks-control-plane-sg\"\n",
        "    \"kubernetes.io/cluster/${var.cluster_name}\" = \"owned\" # Tag required by EKS\n",
        "  }\n",
        "}\n",
        "\n",
        "# Define Security Group for EKS Worker Nodes\n",
        "resource \"aws_security_group\" \"eks_worker_node_sg\" {\n",
        "  name        = \"agi-automotive-eks-worker-node-sg\"\n",
        "  description = \"Security group for EKS worker nodes\"\n",
        "  vpc_id      = aws_vpc.eks_vpc.id\n",
        "\n",
        "   ingress {\n",
        "    description = \"Allow all traffic from other worker nodes\"\n",
        "    from_port   = 0\n",
        "    to_port     = 0\n",
        "    protocol    = \"-1\"\n",
        "    self = true\n",
        "  }\n",
        "\n",
        "  ingress {\n",
        "      description = \"Allow inbound traffic from public subnets (for ELBs/ALBs)\"\n",
        "      from_port   = 0\n",
        "      to_port     = 0\n",
        "      protocol    = \"-1\"\n",
        "      cidr_blocks = aws_subnet.public_subnets[*].cidr_block\n",
        "  }\n",
        "\n",
        "  egress {\n",
        "    description = \"Allow all outbound traffic\"\n",
        "    from_port   = 0\n",
        "    to_port     = 0\n",
        "    protocol    = \"-1\"\n",
        "    cidr_blocks = [\"0.0.0.0/0\"]\n",
        "  }\n",
        "\n",
        "  tags = {\n",
        "    Name = \"agi-automotive-eks-worker-node-sg\"\n",
        "    \"kubernetes.io/cluster/${var.cluster_name}\" = \"owned\" # Tag required by EKS\n",
        "  }\n",
        "}\n",
        "\n",
        "# Add ingress rule to control plane SG allowing traffic from worker nodes\n",
        "resource \"aws_security_group_rule\" \"control_plane_from_worker_nodes\" {\n",
        "  type              = \"ingress\"\n",
        "  from_port         = 0\n",
        "  to_port           = 0\n",
        "  protocol          = \"-1\"\n",
        "  description       = \"Allow all traffic from worker nodes\"\n",
        "  security_group_id = aws_security_group.eks_control_plane_sg.id\n",
        "  source_security_group_id = aws_security_group.eks_worker_node_sg.id\n",
        "}\n",
        "\n",
        "# Add ingress rule to worker node SG allowing traffic from control plane\n",
        "resource \"aws_security_group_rule\" \"worker_nodes_from_control_plane\" {\n",
        "  type              = \"ingress\"\n",
        "  from_port         = 0\n",
        "  to_port           = 0\n",
        "  protocol          = \"-1\"\n",
        "  description       = \"Allow all traffic from control plane\"\n",
        "  security_group_id = aws_security_group.eks_worker_node_sg.id\n",
        "  source_security_group_id = aws_security_group.eks_control_plane_sg.id\n",
        "}\n",
        "\n",
        "\n",
        "# Define IAM role for the EKS cluster control plane\n",
        "resource \"aws_iam_role\" \"eks_cluster_role\" {\n",
        "  name = \"agi-automotive-eks-cluster-role\"\n",
        "\n",
        "  assume_role_policy = jsonencode({\n",
        "    Version = \"2012-10-17\"\n",
        "    Statement = [\n",
        "      {\n",
        "        Effect = \"Allow\"\n",
        "        Principal = {\n",
        "          Service = \"eks.amazonaws.com\"\n",
        "        }\n",
        "        Action = \"sts:AssumeRole\"\n",
        "      }\n",
        "    ]\n",
        "  })\n",
        "}\n",
        "\n",
        "# Attach the AmazonEKSClusterPolicy managed policy to the EKS cluster role\n",
        "resource \"aws_iam_role_policy_attachment\" \"eks_cluster_policy_attachment\" {\n",
        "  policy_arn = \"arn:aws:iam::aws:policy/AmazonEKSClusterPolicy\"\n",
        "  role       = aws_iam_role.eks_cluster_role.name\n",
        "}\n",
        "\n",
        "# Attach the AmazonEC2ContainerRegistryReadOnly managed policy (optional but recommended)\n",
        "resource \"aws_iam_role_policy_attachment\" \"eks_cluster_ecr_policy_attachment\" {\n",
        "  policy_arn = \"arn:aws:iam::aws:policy/AmazonEC2ContainerRegistryReadOnly\"\n",
        "  role       = aws_iam_role.eks_cluster_role.name\n",
        "}\n",
        "\n",
        "# Define the EKS cluster resource\n",
        "resource \"aws_eks_cluster\" \"agi_automotive_eks_cluster\" {\n",
        "  name     = var.cluster_name\n",
        "  role_arn = aws_iam_role.eks_cluster_role.arn\n",
        "  version  = \"1.29\" # Specify your desired Kubernetes version\n",
        "\n",
        "  vpc_config {\n",
        "    subnet_ids              = concat(aws_subnet.public_subnets[*].id, aws_subnet.private_subnets[*].id)\n",
        "    security_group_ids      = [aws_security_group.eks_control_plane_sg.id]\n",
        "    endpoint_private_access = true # Enable private endpoint access\n",
        "    endpoint_public_access  = true # Enable public endpoint access (can be disabled later if needed)\n",
        "    public_access_cidrs     = [\"0.0.0.0/0\"] # Restrict public access CIDRs as needed\n",
        "  }\n",
        "\n",
        "  # Enable logging (optional but recommended)\n",
        "  enabled_cluster_log_types = [\"api\", \"audit\", \"authenticator\", \"controllerManager\", \"scheduler\"]\n",
        "\n",
        "  tags = {\n",
        "    Name = \"agi-automotive-eks-cluster\"\n",
        "  }\n",
        "\n",
        "  # Ensure that IAM Role permissions are created before and deleted after EKS Cluster handling.\n",
        "  depends_on = [\n",
        "    aws_iam_role_policy_attachment.eks_cluster_policy_attachment,\n",
        "    aws_iam_role_policy_attachment.eks_cluster_ecr_policy_attachment,\n",
        "  ]\n",
        "}\n",
        "\n",
        "# Define IAM role for EKS Node Groups\n",
        "resource \"aws_iam_role\" \"eks_node_group_role\" {\n",
        "  name = \"agi-automotive-eks-node-group-role\"\n",
        "\n",
        "  assume_role_policy = jsonencode({\n",
        "    Version = \"2012-10-17\"\n",
        "    Statement = [\n",
        "      {\n",
        "        Effect = \"Allow\"\n",
        "        Principal = {\n",
        "          Service = \"ec2.amazonaws.com\"\n",
        "        }\n",
        "        Action = \"sts:AssumeRole\"\n",
        "      }\n",
        "    ]\n",
        "  })\n",
        "}\n",
        "\n",
        "# Attach necessary AWS managed policies to the node group role\n",
        "resource \"aws_iam_role_policy_attachment\" \"eks_node_group_amazon_eks_worker_node_policy\" {\n",
        "  policy_arn = \"arn:aws:iam::aws:policy/AmazonEKSWorkerNodePolicy\"\n",
        "  role       = aws_iam_role.eks_node_group_role.name\n",
        "}\n",
        "\n",
        "resource \"aws_iam_role_policy_attachment\" \"eks_node_group_amazon_eks_cni_policy\" {\n",
        "  policy_arn = \"arn:aws:iam::aws:policy/AmazonEKS_CNI_Policy\"\n",
        "  role       = aws_iam_role.eks_node_group_role.name\n",
        "}\n",
        "\n",
        "resource \"aws_iam_role_policy_attachment\" \"eks_node_group_amazon_ec2_container_registry_read_only\" {\n",
        "  policy_arn = \"arn:aws:iam::aws:policy/AmazonEC2ContainerRegistryReadOnly\"\n",
        "  role       = aws_iam_role.eks_node_group_role.name\n",
        "}\n",
        "\n",
        "# Define an EKS managed node group\n",
        "resource \"aws_eks_node_group\" \"agi_automotive_node_group\" {\n",
        "  cluster_name    = aws_eks_cluster.agi_automotive_eks_cluster.name\n",
        "  node_group_name = \"agi-automotive-node-group-1\"\n",
        "  node_role_arn   = aws_iam_role.eks_node_group_role.arn\n",
        "  subnet_ids      = aws_subnet.private_subnets[*].id # Associate with private subnets\n",
        "  instance_types  = [\"t3.medium\"] # Specify desired instance type\n",
        "\n",
        "  scaling_config {\n",
        "    desired_size = 2 # Desired number of nodes\n",
        "    max_size     = 3 # Maximum number of nodes\n",
        "    min_size     = 1 # Minimum number of nodes\n",
        "  }\n",
        "\n",
        "  # Ensure that IAM Role permissions are created before and deleted after EKS Node Group handling.\n",
        "  depends_on = [\n",
        "    aws_iam_role_policy_attachment.eks_node_group_amazon_eks_worker_node_policy,\n",
        "    aws_iam_role_policy_attachment.eks_node_group_amazon_eks_cni_policy,\n",
        "    aws_iam_role_policy_attachment.eks_node_group_amazon_ec2_container_registry_read_only,\n",
        "  ]\n",
        "\n",
        "  tags = {\n",
        "    Name = \"agi-automotive-eks-node-group\"\n",
        "    \"kubernetes.io/cluster/${var.cluster_name}\" = \"owned\" # Tag required by EKS\n",
        "  }\n",
        "}\n",
        "\n",
        "# Define outputs for the created resources\n",
        "output \"cluster_name\" {\n",
        "  description = \"The name of the EKS cluster\"\n",
        "  value       = aws_eks_cluster.agi_automotive_eks_cluster.name\n",
        "}\n",
        "\n",
        "output \"cluster_endpoint\" {\n",
        "  description = \"The endpoint for the EKS cluster\"\n",
        "  value       = aws_eks_cluster.agi_automotive_eks_cluster.endpoint\n",
        "}\n",
        "\n",
        "output \"cluster_certificate_authority_data\" {\n",
        "  description = \"The base64 encoded certificate data required to communicate with the cluster\"\n",
        "  value       = aws_eks_cluster.agi_automotive_eks_cluster.certificate_authority[0].data\n",
        "}\n",
        "\n",
        "output \"cluster_security_group_id\" {\n",
        "  description = \"The security group ID of the EKS cluster control plane\"\n",
        "  value       = aws_security_group.eks_control_plane_sg.id\n",
        "}\n",
        "\n",
        "output \"worker_node_security_group_id\" {\n",
        "  description = \"The security group ID of the EKS worker nodes\"\n",
        "  value       = aws_security_group.eks_worker_node_sg.id\n",
        "}\n",
        "\n",
        "output \"vpc_id\" {\n",
        "  description = \"The ID of the VPC\"\n",
        "  value       = aws_vpc.eks_vpc.id\n",
        "}\n",
        "\n",
        "output \"public_subnet_ids\" {\n",
        "  description = \"List of public subnet IDs\"\n",
        "  value       = aws_subnet.public_subnets[*].id\n",
        "}\n",
        "\n",
        "output \"private_subnet_ids\" {\n",
        "  description = \"List of private subnet IDs\"\n",
        "  value       = aws_subnet.private_subnets[*].id\n",
        "}\n",
        "\n",
        "# Define a variable for the cluster name\n",
        "variable \"cluster_name\" {\n",
        "  description = \"The name of the EKS cluster\"\n",
        "  type        = string\n",
        "  default     = \"agi-automotive-eks-cluster\"\n",
        "}\n",
        "\n",
        "\n",
        "# Configure the Kubernetes Provider to connect to the EKS cluster\n",
        "provider \"kubernetes\" {\n",
        "  host                   = aws_eks_cluster.agi_automotive_eks_cluster.endpoint\n",
        "  cluster_ca_certificate = base64decode(aws_eks_cluster.agi_automotive_eks_cluster.certificate_authority[0].data)\n",
        "  token                  = data.aws_eks_cluster_auth.current.token\n",
        "}\n",
        "\n",
        "# Data source to get AWS authenticator token for Kubernetes\n",
        "data \"aws_eks_cluster_auth\" \"current\" {\n",
        "  name = aws_eks_cluster.agi_automotive_eks_cluster.name\n",
        "}\n",
        "\n",
        "# Configure the Helm Provider to deploy charts to the EKS cluster\n",
        "provider \"helm\" {\n",
        "  # Corrected: Pass kubernetes configuration as an argument\n",
        "  kubernetes = {\n",
        "    host                   = aws_eks_cluster.agi_automotive_eks_cluster.endpoint\n",
        "    cluster_ca_certificate = base64decode(aws_eks_cluster.agi_automotive_eks_cluster.certificate_authority[0].data)\n",
        "    token                  = data.aws_eks_cluster_auth.current.token\n",
        "  }\n",
        "}\n",
        "\n",
        "# Define a Kubernetes Namespace for Strimzi and Kafka\n",
        "resource \"kubernetes_namespace\" \"kafka_namespace\" {\n",
        "  metadata {\n",
        "    name = \"kafka\"\n",
        "  }\n",
        "}\n",
        "\n",
        "# Deploy the Strimzi Kafka operator using the Helm provider\n",
        "resource \"helm_release\" \"strimzi_operator\" {\n",
        "  name       = \"strimzi-kafka-operator\"\n",
        "  repository = \"https://strimzi.io/charts/\"\n",
        "  chart      = \"strimzi-kafka-operator\"\n",
        "  namespace  = kubernetes_namespace.kafka_namespace.metadata[0].name\n",
        "  version    = \"0.41.0\" # Specify a compatible Strimzi version\n",
        "  timeout    = 600\n",
        "\n",
        "  values = [\n",
        "    file(\"prometheus_values.yaml\") # Assuming prometheus_values.yaml contains Strimzi-specific Prometheus configuration\n",
        "  ]\n",
        "\n",
        "  depends_on = [kubernetes_namespace.kafka_namespace]\n",
        "}\n",
        "\n",
        "# Define the Kafka cluster Custom Resource\n",
        "# This resource depends on the Strimzi operator being deployed and ready.\n",
        "resource \"kubernetes_manifest\" \"kafka_cluster\" {\n",
        "  provider = kubernetes # Explicitly use the kubernetes provider\n",
        "\n",
        "  manifest = {\n",
        "    apiVersion = \"kafka.strimzi.io/v1beta2\"\n",
        "    kind       = \"Kafka\"\n",
        "    metadata = {\n",
        "      name      = \"my-kafka-cluster\" # Name of your Kafka cluster\n",
        "      namespace = kubernetes_namespace.kafka_namespace.metadata[0].name\n",
        "    }\n",
        "    spec = {\n",
        "      kafka = {\n",
        "        version = \"3.7.0\" # Specify Kafka version\n",
        "        replicas = 3      # Number of Kafka brokers\n",
        "        listeners = [\n",
        "          {\n",
        "            name = \"plain\"\n",
        "            port = 9092\n",
        "            type = \"internal\" # Internal listener for agents within EKS\n",
        "            tls = false\n",
        "          },\n",
        "          {\n",
        "            name = \"tls\"\n",
        "            port = 9093\n",
        "            type = \"internal\" # TLS listener for agents within EKS\n",
        "            tls = true\n",
        "            authentication = {\n",
        "              type = \"tls\"\n",
        "            }\n",
        "          }\n",
        "        ]\n",
        "        storage = {\n",
        "          type = \"jbod\"\n",
        "          volumes = [\n",
        "            {\n",
        "              id = 0\n",
        "              type = \"persistent-claim\"\n",
        "              size = \"100Gi\" # Size of persistent volume per broker\n",
        "              deleteClaim = false\n",
        "            }\n",
        "          ]\n",
        "        }\n",
        "        # Configure resources for Kafka brokers\n",
        "        resources = {\n",
        "          requests = {\n",
        "            cpu = \"500m\"\n",
        "            memory = \"2Gi\"\n",
        "          }\n",
        "          limits = {\n",
        "            cpu = \"2000m\"\n",
        "            memory = \"8Gi\"\n",
        "          }\n",
        "        }\n",
        "      }\n",
        "      zookeeper = {\n",
        "        replicas = 3 # Number of ZooKeeper nodes\n",
        "        storage = {\n",
        "          type = \"persistent-claim\"\n",
        "          size = \"10Gi\" # Size of persistent volume per ZooKeeper node\n",
        "          deleteClaim = false\n",
        "        }\n",
        "        # Configure resources for ZooKeeper nodes\n",
        "        resources = {\n",
        "          requests = {\n",
        "            cpu = \"200m\"\n",
        "            memory = \"1Gi\"\n",
        "          }\n",
        "          limits = {\n",
        "            cpu = \"1000m\"\n",
        "            memory = \"4Gi\"\n",
        "          }\n",
        "        }\n",
        "      }\n",
        "      entity_operator = {\n",
        "        topicOperator = {}\n",
        "        userOperator = {}\n",
        "      }\n",
        "    }\n",
        "  }\n",
        "\n",
        "  depends_on = [helm_release.strimzi_operator]\n",
        "}\n",
        "\n",
        "# Add outputs for Kafka cluster details if needed\n",
        "output \"kafka_namespace\" {\n",
        "  description = \"The name of the Kubernetes namespace for Kafka\"\n",
        "  value       = kubernetes_namespace.kafka_namespace.metadata[0].name\n",
        "}\n",
        "\n",
        "output \"kafka_cluster_name\" {\n",
        "  description = \"The name of the Kafka cluster\"\n",
        "  value       = kubernetes_manifest.kafka_cluster.manifest.metadata.name\n",
        "}\n",
        "\n",
        "output \"kafka_brokers_internal\" {\n",
        "  description = \"Internal Kafka broker addresses (example, actual service may vary)\"\n",
        "  value       = \"my-kafka-cluster-kafka-bootstrap.kafka.svc.cluster.local:9092\" # Example internal address\n",
        "}\n",
        "\n",
        "\n",
        "# Define a Kubernetes Namespace for Monitoring components\n",
        "resource \"kubernetes_namespace\" \"monitoring_namespace\" {\n",
        "  metadata {\n",
        "    name = \"monitoring\"\n",
        "  }\n",
        "}\n",
        "\n",
        "# Deploy the Prometheus stack using the Helm provider\n",
        "# Using the stable community-maintained kube-prometheus-stack chart\n",
        "resource \"helm_release\" \"prometheus_stack\" {\n",
        "  name       = \"prometheus\"\n",
        "  repository = \"https://prometheus-community.github.io/helm-charts\"\n",
        "  chart      = \"kube-prometheus-stack\"\n",
        "  namespace  = kubernetes_namespace.monitoring_namespace.metadata[0].name\n",
        "  version    = \"58.3.1\" # Specify a compatible chart version\n",
        "  timeout    = 900 # Increase timeout as this chart deploys multiple components\n",
        "\n",
        "  values = [\n",
        "    # Standard configuration values for the chart\n",
        "    file(\"prometheus_values.yaml\"), # Reference the provided prometheus_values.yaml\n",
        "  ]\n",
        "\n",
        "  depends_on = [\n",
        "    kubernetes_namespace.monitoring_namespace,\n",
        "    helm_release.strimzi_operator # Ensure Strimzi CRDs are applied before scraping Kafka/Strimzi components\n",
        "  ]\n",
        "}\n",
        "\n",
        "\"\"\"\n",
        "\n",
        "# Write the complete and corrected Terraform configuration to main.tf\n",
        "with open(\"main.tf\", \"w\") as f:\n",
        "    f.write(complete_terraform_config_helm_corrected)\n",
        "\n",
        "print(\"Complete and corrected Terraform configuration written to main.tf\")\n",
        "\n",
        "# Initialize the Terraform working directory\n",
        "!terraform init\n",
        "\n",
        "# Review the execution plan\n",
        "!terraform plan\n",
        "\n",
        "# Apply the Terraform configuration to provision the EKS cluster, Kafka/Strimzi, and Monitoring\n",
        "# The '-auto-approve' flag is used for automation; remove for manual confirmation\n",
        "!terraform apply -auto-approve"
      ]
    },
